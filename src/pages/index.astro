---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Carousel from '../components/Carousel.astro';
import Goals from '../components/Goals.astro';
import About from '../components/About.astro';
import Steps from '../components/Steps.astro';
import Intake from '../components/Intake.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Jikke | Voedingscoaching rond pure voeding"
  description="Persoonlijke voedingscoaching rond pure voeding. Afvallen, op gewicht blijven of aankomen, met een plan dat bij jouw leven past. Start met een gratis intake."
>
  <Hero />
  <main>
    <Statement />
    <Carousel />
    <Goals />
    <About />
    <Steps />
    <Intake />
    <Faq />
  </main>
  <Footer />
</Layout>
