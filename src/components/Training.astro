---
import { training } from '../data/site.js';
---

<section id="training" class="training container">
  <img class="training__img" src={training.img} alt={training.alt} loading="lazy" />
  <div class="training__text">
    <h2 class="h h--lg" set:html={training.title} />
    <p>{training.body}</p>
    <ul class="checks checks--dark">
      {training.list.map((item) => <li><span class="ck"><i data-lucide="check"></i></span>{item}</li>)}
    </ul>
    <a href="#intake" class="btn btn--dark">{training.cta} <i data-lucide="arrow-right"></i></a>
  </div>
</section>
